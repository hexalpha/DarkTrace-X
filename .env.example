# Runtime
APP_ENV=development
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL_PATH=./qwen3-4b-cybersecurity-heretic-16bit-q4_k_m.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=4
LOCAL_LLM_GPU_LAYERS=-1
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_TOKENS=512
# Generate protected keys with: python scripts/setup_copilot.py
# Docker loads .runtime/copilot.env; never commit it.
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data plane
POSTGRES_DB=darktracex
POSTGRES_USER=darktrace
POSTGRES_PASSWORD=
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PASSWORD=
# Use docker-compose.elasticsearch-tls.yml for HTTPS. Bundle must contain
# ca.crt, tls.crt, tls.key; certificate SANs must include elasticsearch and localhost.
ELASTICSEARCH_CERT_DIRECTORY=
ELASTICSEARCH_CA_CERTS=
# Required with scripts/start.ps1 -Production or scripts/start.sh FILE --production
PUBLIC_ORIGIN=
TLS_CERT_DIRECTORY=
AI_SECRET_KEY=
COPILOT_WORKER_KEY=

# AI control plane. Local Qwen is the default; external AI is opt-in.
AI_DEFAULT_PROVIDER=local
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_PROVIDER_NAME=OpenAI-compatible
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_MODEL=gpt-4o-mini
EXTERNAL_AI_API_KEY=
LOCAL_AI_MAX_OUTPUT_TOKENS=128

# Source crawling scheduler. Set false when an external worker owns scheduling.
CRAWLER_SCHEDULER_ENABLED=true
CRAWLER_SCHEDULER_INTERVAL_SECONDS=30

# Integrations (one secret per deployment/environment)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
