# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-32-byte-minimum-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data plane
DATABASE_URL=postgresql+asyncpg://darktrace:darktrace@postgres:5432/darktracex
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200

# AI control plane. Keep provider keys server-side only.
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_ORDER=openai,groq,openrouter,ollama
OPENAI_MODEL=gpt-5.6
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1
LLAMA_CPP_BASE_URL=http://host.docker.internal:8080/v1
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Integrations (one secret per deployment/environment)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
SMTP_URL=

