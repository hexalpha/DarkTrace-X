# Copy outside source control, replace values, then create darktracex-runtime.
# Use managed PostgreSQL/Elasticsearch for clustered production deployment.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POSTGRES_HOST:5432/darktracex
ELASTICSEARCH_URL=https://ELASTICSEARCH_HOST:9200
REDIS_URL=rediss://REDIS_HOST:6379/0
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=https://YOUR_HOSTNAME
LOCAL_LLM_ENABLED=true
LOCAL_LLM_SERVICE_URL=http://darktracex-local-llm:8091
COPILOT_WORKER_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_WORKER_KEY
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=REPLACE_FROM_SECRET_MANAGER
OPENAI_MODEL=gpt-5.6
AI_ALLOW_CLOUD_FALLBACK=false
